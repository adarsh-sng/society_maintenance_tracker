# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/society_maintenance
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/society_maintenance_test

# Server Configuration
PORT=3000
NODE_ENV=development
APP_STAGE=dev

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=token

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Overdue Detection (days before complaint is considered overdue)
OVERDUE_DAYS=7

# Email Configuration (optional - uses Ethereal test account if not set)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your_sendgrid_api_key
# EMAIL_FROM=noreply@yourdomain.com

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug